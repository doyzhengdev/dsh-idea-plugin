{
  "name": "dsh-plugin-jetbrains",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DSH for Desktop 配套 DSH 插件：提供 IDE 桥（打开文件 / 插入引用 / 工作区过滤）、localStorage 快照与首次启动语言/主题对齐。管理功能在 IDEA 插件的设置弹窗。",
  "icon": "./icon.svg",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src/index.js",
    "src/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
